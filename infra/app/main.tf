# Root stack for real AWS. All resources live in ../modules/netloom; this file
# only wires provider, remote state and environment-specific inputs.

terraform {
  required_version = ">= 1.10"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.30"
    }
  }

  # Partial configuration: values come from backend.hcl, generated by
  # infra/bootstrap (bucket, key, region, use_lockfile).
  backend "s3" {}
}

provider "aws" {
  region = var.region

  default_tags {
    tags = {
      Project     = var.project
      Environment = var.environment
      ManagedBy   = "terraform"
      Repository  = var.repository
    }
  }
}

module "netloom" {
  source = "../modules/netloom"

  project                 = var.project
  environment             = var.environment
  invited_users           = var.invited_users
  cors_allowed_origins    = var.cors_allowed_origins
  protect_data            = var.protect_data
  max_subnets_per_network = var.max_subnets_per_network
  log_retention_days      = var.log_retention_days
}
